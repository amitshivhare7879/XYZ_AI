# ==============================================================================
# XYZ AI — School ERP Ecosystem Environment Variables (.env)
# ==============================================================================

# 1. Google Gemini AI API Configuration
# Get your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 2. Supabase Cloud Configuration (PostgreSQL Database & Auth)
# Get from Supabase Project Settings -> API & Database
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# 3. Direct PostgreSQL Database Connection String (Optional for direct psycopg2 / SQLAlchemy)
# Example: postgresql://postgres:password@db.your-project-id.supabase.co:5432/postgres
DATABASE_URL=

# 4. Fallback Mode (Runs with local SQLite database if Supabase is not connected)
USE_LOCAL_SQLITE_FALLBACK=true

# 5. Internal JWT Secret Key (for local token issuance and verification)
JWT_SECRET_KEY=xyz-ai-school-erp-super-secret-key-2026

# 6. Environment Mode
ENVIRONMENT=development
